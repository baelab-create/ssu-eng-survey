rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 의견수렴: 누구나 읽고 새 응답을 추가할 수 있음. 필드는 선택·의견·서버 시각 셋만.
    // 수정·삭제는 클라이언트에서 불가(콘솔에서만).
    match /ssu_survey/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['position', 'comment', 'createdAt'])
        && request.resource.data.position in ['찬성', '반대', '유보', '기타']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
